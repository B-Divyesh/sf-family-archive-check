{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Family Archive Check",
  "version": "0.1.3",
  "identifier": "in.sociobot.family-archive-check",
  "build": {
    "features": ["desktop"],
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [{
      "title": "Family Archive Check",
      "width": 1180,
      "height": 820,
      "minWidth": 390,
      "minHeight": 640,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.sociobot.in" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Check family photo backup copies",
    "longDescription": "Read-only folder checks and recovery manifests for family photo and video archives.",
    "copyright": "Copyright 2026 Param Factory",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
